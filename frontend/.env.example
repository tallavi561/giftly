VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Leave unset for local dev — Vite proxies /api to localhost:3001 (see vite.config.ts).
# In production, set this to the deployed backend's own URL, e.g. https://giftly-backend.onrender.com
VITE_API_URL=
